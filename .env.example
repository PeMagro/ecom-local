# Local SQLite database (see sqlite/)
SQLITE_DB_PATH="./data/ecom.db"

# Seals the local session cookie (src/lib/sqlite/session.ts). Generate your own:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Optional — enables the ECO AI assistant (Lovable AI gateway)
LOVABLE_API_KEY=""

# Required by the ECOM agent v1 (src/lib/agent-ecom/) — completude de cadastro,
# anúncios e alertas de estoque. Get a key at console.anthropic.com
ANTHROPIC_API_KEY=""
# Optional — defaults to claude-sonnet-5
ECOM_AGENT_MODEL=""

# Optional — Mercado Livre OAuth app (developers.mercadolivre.com.br)
MERCADO_LIVRE_CLIENT_ID=""
MERCADO_LIVRE_CLIENT_SECRET=""

# Optional — Shopee Open Platform app
SHOPEE_PARTNER_ID=""
SHOPEE_PARTNER_KEY=""

# Optional — Amazon Selling Partner API app
AMAZON_SP_CLIENT_ID=""
AMAZON_SP_CLIENT_SECRET=""

# Needed for marketplace OAuth redirect URIs, e.g. http://localhost:8080
APP_URL=""

# Optional — shared secret for cron/webhook endpoints, if used
LOVABLE_CRON_SECRET=""
LOVABLE_CRON_SECRET_PREVIOUS=""
